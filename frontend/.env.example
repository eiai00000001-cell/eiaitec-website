# お問い合わせフォーム送信(F-07)用の環境変数。
# F-07(Resend連携)は本イテレーション(第1段)では未実装のため、
# 値の記載・実際の送信テストは次段の実装時に行う。
# 詳細設計書 7.3節 / 基本設計書 5.2節参照。値は本ファイルに記載しないこと。

RESEND_API_KEY=
CONTACT_RECEIVE_EMAIL=
RESEND_FROM_EMAIL=

# 開発サーバー(`npm run dev`)をLAN内の他端末(スマホ実機確認等)から
# アクセスする場合にのみ設定する。各自のマシンのLAN IPを`.env.local`に設定すること
# (`npm run dev`実行時にターミナルへ表示される "Network:" のIP)。
# 未設定の場合はLAN内の他端末からのアクセスは許可されない(レビュー結果報告書 R-6)。
DEV_ALLOWED_ORIGIN=
